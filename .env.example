# Copy to .env to override defaults — everything here is optional and
# matches the repo-root docker-compose.yml stack (docker compose up -d).
#
# Read by src/knowledge_graph/connect.py (build_graph / writer / qa / schema),
# and NEO4J_PASSWORD is interpolated by docker-compose.yml for the container.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pharmacoldops

# 团队共享调度数据库（不要提交真实密码）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
