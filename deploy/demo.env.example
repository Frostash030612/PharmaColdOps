# Copy to deploy/demo.env (ignored); use a unique >=12-character password.
NEO4J_PASSWORD=CHANGE_ME_BEFORE_START
DEMO_PORT=8080
# Loopback only. No public exposure without authentication/TLS and access review.
DEMO_BIND_ADDRESS=127.0.0.1
# Optional pinned local/registry image override, especially for offline builds.
# NEO4J_IMAGE=neo4j@sha256:YOUR_VERIFIED_MANIFEST_DIGEST
