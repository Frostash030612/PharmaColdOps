# Course materials (copyrighted) — kept out by default, except the shared reference PDFs
*.pdf
!proposal/*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# Processed/derived artifacts stay out of git; raw datasets ARE tracked (team decision 2026-09-08)
# 用 /* 而非 / 排除目录本身——否则下面的 ! 否定规则不生效（git 不会进入被排除的目录）。
data/processed/*
# 例外：这两份是标注交付件，不是可重生成的中间产物（2026-09-12）。
!data/processed/agreement_stats.md
!data/processed/PROVENANCE.md

# Runtime run-history log written by the decision API (data/audit/runs.jsonl)
data/audit/

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Office temporary lock files
~$*.docx
~$*.pptx

# Claude Code local config
.claude/

# Node / Vite (frontend-vue) — dependency & build output stay out of git
frontend-vue/node_modules/
frontend-vue/dist/

# Cached map tiles for the offline basemap (scripts/fetch_map_tiles.mjs):
# regenerable, ~2-3 MB of third-party PNGs. Delete the next line if you would
# rather commit them so the demo map works with no internet at all.
frontend-vue/public/tiles/

# Uncropped originals of the proposal's demo screenshots. proposal/README.md
# states these stay on the submitting machine; only the cropped, referenced
# files (demo-*.png, kg-neo4j-browser.png) belong in the repository.
proposal/figures/raw/

# Tool scratch dirs (all regenerable, none is a deliverable)
.pytest_cache/
.pytest_tmp/
.pytmp/
# OSMnx/Nominatim geocoder response cache written by the road-network build
cache/
output/playwright/
.playwright-cli/
